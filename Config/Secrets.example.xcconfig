// Copy to Config/Secrets.xcconfig (gitignored) and fill in locally.
// Never put real values in this file.
//
// Google OAuth "Desktop app" client from your own Google Cloud project.
// Tokens are never stored here: the app keeps them in the macOS Keychain.
GOOGLE_OAUTH_CLIENT_ID = YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET = YOUR_CLIENT_SECRET

// The Anthropic / OpenRouter key is entered in Settings and stored in the
// Keychain, not in build config.
